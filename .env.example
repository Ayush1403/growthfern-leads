# Where leads are emailed
ALERT_EMAIL=you@example.com
# Gmail sender: SMTP_USER is a Gmail address, SMTP_PASS is a Google App Password
# (myaccount.google.com/apppasswords, needs 2-Step Verification). Not your normal password.
SMTP_USER=
# If the password has spaces, wrap it in quotes.
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Recommended: Reddit script app (reddit.com/prefs/apps). Without it Reddit uses the rate-limited public RSS.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: Claude classifier + personalized drafts (without it: keyword filter + template reply)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# 1 = print matches only, send nothing
DRY_RUN=1
POLL_SECONDS=120
# Subreddits joined with +
SUBREDDITS=forhire+hiring+slavelabour+startups+smallbusiness+Entrepreneur+marketing+web_design+SaaS
# Extra RSS job feeds, comma separated (defaults: We Work Remotely design, full-stack)
# FEEDS=https://weworkremotely.com/categories/remote-design-jobs.rss,https://himalayas.app/jobs/rss
USER_AGENT="growthfern-leads/1.0 (contact: growthfern.in)"

DB_PATH=leads.db
